{
  "name": "investigate",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade TanStack Start foundation for Investigate",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "NODE_ENV=production vite build",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=smoke --project=chromium",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:all": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "knip": "knip --exclude exports,types,nsExports,nsTypes,duplicates",
    "knip:full": "knip",
    "deps:check": "pnpm outdated || true",
    "deps:audit": "pnpm audit --prod",
    "perf": "node scripts/ci/perf-budget.mjs",
    "bundle:report": "node scripts/ci/bundle-report.mjs",
    "verify": "node scripts/ci/verify.mjs",
    "ci:local": "pnpm verify",
    "release:check": "node scripts/ci/release-check.mjs",
    "runner:check": "node scripts/runners/check-toolchain.mjs",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.28.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.0",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-cli": "1.167.21",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "madge": "8.0.0",
    "msw": "2.15.0",
    "rollup-plugin-visualizer": "7.0.1",
    "shadcn": "4.16.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "lefthook"
    ]
  }
}
