# InvestigatAI Security Standards

## Data Security Principles

### 1. Data Classification
All data must be classified and handled according to sensitivity:

```typescript
// core/security/data-classification.ts
export enum DataClassification {
  PUBLIC = "public",
  INTERNAL = "internal", 
  CONFIDENTIAL = "confidential",
  RESTRICTED = "restricted"
}

export interface ClassifiedData {
  classification: DataClassification;
  data: any;
  encryptionRequired: boolean;
  auditRequired: boolean;
}
```

### 2. Data Access Layer Security
Implement secure data access patterns:

```typescript
// core/database/repositories/base-repository.ts
export abstract class BaseRepository<T> {
  protected async findWithAuthorization<K>(
    criteria: K,
    userId: string,
    requiredPermission: Permission
  ): Promise<T[]> {
    // 1. Verify user authorization
    await this.authService.checkPermission(userId, requiredPermission);
    
    // 2. Apply RLS (Row Level Security) filters
    const securityFilters = await this.getSecurityFilters(userId);
    
    // 3. Execute query with combined filters
    return this.find({ ...criteria, ...securityFilters });
  }
  
  protected abstract getSecurityFilters(userId: string): Promise<Record<string, any>>;
}
```

## Authentication & Authorization

### 1. JWT Token Management
```typescript
// core/security/auth/jwt-service.ts
export class JWTService {
  static async generateTokens(user: User): Promise<TokenPair> {
    const accessToken = jwt.sign(
      { 
        userId: user.id, 
        role: user.role,
        permissions: user.permissions 
      },
      process.env.JWT_SECRET!,
      { expiresIn: '15m', issuer: 'investigatai' }
    );
    
    const refreshToken = jwt.sign(
      { userId: user.id, tokenType: 'refresh' },
      process.env.JWT_REFRESH_SECRET!,
      { expiresIn: '7d', issuer: 'investigatai' }
    );
    
    return { accessToken, refreshToken };
  }
  
  static async validateToken(token: string): Promise<JWTPayload> {
    try {
      return jwt.verify(token, process.env.JWT_SECRET!) as JWTPayload;
    } catch (error) {
      throw new AuthenticationError("Invalid token");
    }
  }
}
```

### 2. Role-Based Access Control (RBAC)
```typescript
// core/security/auth/permission-service.ts
export class PermissionService {
  private static rolePermissions: Record<UserRole, Permission[]> = {
    [UserRole.ADMIN]: ["*"], // All permissions
    [UserRole.INVESTIGATOR]: [
      "investigation:create",
      "investigation:read:own",
      "investigation:update:own", 
      "evidence:upload",
      "evidence:analyze"
    ],
    [UserRole.VIEWER]: [
      "investigation:read:shared",
      "evidence:view:shared"
    ]
  };
  
  static async checkPermission(
    userId: string, 
    permission: Permission,
    resourceId?: string
  ): Promise<boolean> {
    const user = await UserRepository.findById(userId);
    if (!user) return false;
    
    const userPermissions = this.rolePermissions[user.role];
    
    // Check wildcard permission
    if (userPermissions.includes("*")) return true;
    
    // Check specific permission
    if (userPermissions.includes(permission)) {
      // If resource-specific, check ownership/sharing
      if (resourceId) {
        return this.checkResourceAccess(userId, permission, resourceId);
      }
      return true;
    }
    
    return false;
  }
}
```

## Input Validation & Sanitization

### 1. Zod Schemas with Security Validation
```typescript
// core/shared/schemas/validation-schemas.ts
import { z } from "zod";

export const secureFileNameSchema = z
  .string()
  .min(1, "Filename required")
  .max(255, "Filename too long")
  .regex(/^[a-zA-Z0-9._-]+$/, "Invalid characters in filename")
  .refine(name => !name.includes(".."), "Path traversal not allowed");

export const investigationNameSchema = z
  .string()
  .min(1, "Investigation name required")
  .max(100, "Name too long")
  .regex(/^[a-zA-Z0-9\s._-]+$/, "Invalid characters")
  .transform(name => name.trim());

export const uploadFileSchema = z.object({
  file: z.instanceof(File)
    .refine(file => file.size <= 100 * 1024 * 1024, "File too large")
    .refine(file => ALLOWED_MIME_TYPES.includes(file.type), "File type not allowed"),
  investigationId: z.string().uuid("Invalid investigation ID"),
  classification: z.nativeEnum(DataClassification)
});
```

### 2. SQL Injection Prevention
```typescript
// Always use parameterized queries
export class InvestigationRepository {
  static async findByUserAndStatus(userId: string, status: string): Promise<Investigation[]> {
    // ✅ SAFE - Parameterized query
    const { data, error } = await supabase
      .from("investigations")
      .select("*")
      .eq("created_by", userId)
      .eq("status", status);
    
    if (error) throw new DatabaseError(error.message);
    return data;
  }
  
  // ❌ NEVER DO THIS - String concatenation
  // const query = `SELECT * FROM investigations WHERE user_id = '${userId}'`;
}
```

## File Upload Security

### 1. File Validation
```typescript
// core/evidence/file-validator.ts
export class FileValidator {
  private static readonly ALLOWED_TYPES = [
    "image/jpeg", "image/png", "image/gif",
    "video/mp4", "video/avi", "video/mov",
    "application/pdf", "text/plain"
  ];
  
  private static readonly MAX_FILE_SIZE = 100 * 1024 * 1024; // 100MB
  
  static async validateFile(file: File): Promise<ValidationResult> {
    const errors: string[] = [];
    
    // Size check
    if (file.size > this.MAX_FILE_SIZE) {
      errors.push("File size exceeds limit");
    }
    
    // Type check
    if (!this.ALLOWED_TYPES.includes(file.type)) {
      errors.push("File type not allowed");
    }
    
    // Magic number verification
    const actualType = await this.getMimeTypeFromContent(file);
    if (actualType !== file.type) {
      errors.push("File type mismatch");
    }
    
    // Virus scan (integrate with antivirus service)
    const scanResult = await this.scanForMalware(file);
    if (!scanResult.clean) {
      errors.push("File failed security scan");
    }
    
    return { isValid: errors.length === 0, errors };
  }
  
  private static async getMimeTypeFromContent(file: File): Promise<string> {
    // Read file header to verify actual MIME type
    const buffer = await file.slice(0, 512).arrayBuffer();
    return this.detectMimeType(new Uint8Array(buffer));
  }
}
```

### 2. Secure File Storage
```typescript
// core/evidence/file-storage-service.ts
export class FileStorageService {
  static async storeFile(
    file: File, 
    investigationId: string, 
    userId: string
  ): Promise<StorageResult> {
    // 1. Generate secure file path
    const fileId = generateSecureId();
    const sanitizedName = sanitizeFilename(file.name);
    const storagePath = `investigations/${investigationId}/evidence/${fileId}_${sanitizedName}`;
    
    // 2. Encrypt file if required
    const shouldEncrypt = await this.requiresEncryption(file.type);
    const fileToStore = shouldEncrypt ? await this.encryptFile(file) : file;
    
    // 3. Store with metadata
    const { data, error } = await supabase.storage
      .from("evidence-files")
      .upload(storagePath, fileToStore, {
        cacheControl: "3600",
        upsert: false,
        metadata: {
          originalName: file.name,
          uploadedBy: userId,
          encrypted: shouldEncrypt,
          checksum: await this.calculateChecksum(file)
        }
      });
    
    if (error) throw new StorageError(error.message);
    
    return { 
      storagePath, 
      fileId,
      encrypted: shouldEncrypt,
      checksum: await this.calculateChecksum(file)
    };
  }
}
```

## Audit Logging

### 1. Comprehensive Audit Trail
```typescript
// core/security/audit/audit-logger.ts
export class AuditLogger {
  static async log(event: AuditEvent): Promise<void> {
    const auditRecord = {
      id: generateId(),
      timestamp: new Date().toISOString(),
      userId: event.userId,
      action: event.action,
      resource: event.resource,
      resourceId: event.resourceId,
      ipAddress: event.ipAddress,
      userAgent: event.userAgent,
      success: event.success,
      errorCode: event.errorCode,
      riskLevel: this.calculateRiskLevel(event),
      metadata: event.metadata,
      sessionId: event.sessionId
    };
    
    // Store in secure audit database
    await this.storeAuditRecord(auditRecord);
    
    // Send high-risk events to SIEM
    if (auditRecord.riskLevel === "HIGH" || auditRecord.riskLevel === "CRITICAL") {
      await this.sendToSIEM(auditRecord);
    }
  }
  
  private static calculateRiskLevel(event: AuditEvent): RiskLevel {
    if (event.action.includes("delete") || event.action.includes("admin")) {
      return "HIGH";
    }
    if (!event.success) {
      return "MEDIUM";
    }
    return "LOW";
  }
}
```

