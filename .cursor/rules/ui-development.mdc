# InvestigatAI UI Development Standards

## Component Architecture

### 1. Component Structure
Organize components by domain and reusability:

```
components/
├── ui/                    # Reusable UI primitives (shadcn/ui)
├── investigation/         # Investigation-specific components
│   ├── investigation-workspace.tsx
│   ├── evidence-browser.tsx
│   └── ai-analysis-panel.tsx
├── evidence/             # Evidence handling components
│   ├── file-preview.tsx
│   ├── ai-chat.tsx
│   └── annotation-tool.tsx
├── auth/                 # Authentication components
├── admin/                # Admin panel components
└── shared/               # Shared business components
    ├── data-table.tsx
    ├── search-bar.tsx
    └── status-indicator.tsx
```

### 2. Component Patterns

#### Smart Components (Containers)
Handle data fetching and state management:

```typescript
// components/investigation/investigation-workspace.tsx
"use client";

import { useState, useEffect } from "react";
import { useAuth } from "@/components/auth/auth-provider";
import { EvidenceBrowser } from "./evidence-browser";
import { AIAnalysisPanel } from "./ai-analysis-panel";

interface InvestigationWorkspaceProps {
  investigationId: string;
}

export function InvestigationWorkspace({ investigationId }: InvestigationWorkspaceProps) {
  const { user } = useAuth();
  const [investigation, setInvestigation] = useState<Investigation | null>(null);
  const [files, setFiles] = useState<EvidenceFile[]>([]);
  const [selectedFile, setSelectedFile] = useState<EvidenceFile | null>(null);
  
  useEffect(() => {
    fetchInvestigation();
    fetchFiles();
  }, [investigationId]);
  
  const fetchInvestigation = async () => {
    try {
      const response = await fetch(`/api/investigations/${investigationId}`);
      const data = await response.json();
      setInvestigation(data.data);
    } catch (error) {
      console.error("Failed to fetch investigation:", error);
    }
  };
  
  return (
    <div className="h-screen flex">
      <EvidenceBrowser 
        files={files}
        onFileSelect={setSelectedFile}
        selectedFile={selectedFile}
      />
      <AIAnalysisPanel 
        file={selectedFile}
        investigationId={investigationId}
      />
    </div>
  );
}
```

#### Dumb Components (Presentational)
Focus on rendering and user interaction:

```typescript
// components/evidence/evidence-card.tsx
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { FileIcon, getFileIcon } from "@/components/shared/file-icon";

interface EvidenceCardProps {
  file: EvidenceFile;
  isSelected: boolean;
  onClick: () => void;
}

export function EvidenceCard({ file, isSelected, onClick }: EvidenceCardProps) {
  return (
    <Card 
      className={`cursor-pointer transition-all hover:shadow-md ${
        isSelected ? "ring-2 ring-primary" : ""
      }`}
      onClick={onClick}
    >
      <CardContent className="p-3">
        <div className="flex items-center space-x-3">
          <FileIcon type={file.mime_type} />
          <div className="flex-1 min-w-0">
