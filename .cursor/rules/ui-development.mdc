              <ProcessingStatus status={file.processing_status} />
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
  );
}
```

## Data Fetching Patterns

### 1. Custom Hooks for API Calls
Create reusable hooks for data fetching:

```typescript
// hooks/use-investigation.ts
import { useState, useEffect } from "react";

export function useInvestigation(id: string) {
  const [investigation, setInvestigation] = useState<Investigation | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  
  useEffect(() => {
    fetchInvestigation();
  }, [id]);
  
  const fetchInvestigation = async () => {
    try {
      setLoading(true);
      const response = await fetch(`/api/investigations/${id}`);
      if (!response.ok) throw new Error("Failed to fetch investigation");
      const data = await response.json();
      setInvestigation(data.data);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unknown error");
    } finally {
      setLoading(false);
    }
  };
  
  return { investigation, loading, error, refetch: fetchInvestigation };
}
```

### 2. Server Components for Static Data
Use Next.js Server Components for data that doesn't change:

```typescript
// app/investigations/page.tsx
import { InvestigationList } from "@/components/investigation/investigation-list";

async function getInvestigations() {
  // This runs on the server
  const response = await fetch(`${process.env.API_BASE_URL}/api/investigations`);
  return response.json();
}

export default async function InvestigationsPage() {
  const investigations = await getInvestigations();
  
  return (
    <div>
      <h1>Investigations</h1>
      <InvestigationList investigations={investigations.data} />
    </div>
  );
}
```

## State Management

### 1. Local State with useState
For component-specific state:
```typescript
const [isOpen, setIsOpen] = useState(false);
const [searchQuery, setSearchQuery] = useState("");
```

### 2. Context for Shared State
For state shared across components:
```typescript
// contexts/investigation-context.tsx
const InvestigationContext = createContext<InvestigationContextType | null>(null);

export function InvestigationProvider({ children }: { children: ReactNode }) {
  const [selectedFiles, setSelectedFiles] = useState<string[]>([]);
  const [analysisMode, setAnalysisMode] = useState<AnalysisMode>("overview");
  
  return (
    <InvestigationContext.Provider value={{
      selectedFiles,
      setSelectedFiles,
      analysisMode,
      setAnalysisMode
    }}>
      {children}
    </InvestigationContext.Provider>
  );
}
```

## Styling Standards

### 1. Tailwind CSS Classes
- Use Tailwind utility classes
- Follow mobile-first responsive design
- Use CSS variables for theme consistency
- Prefer Tailwind over custom CSS

### 2. Component Variants
Use class-variance-authority for component variants:
```typescript
import { cva } from "class-variance-authority";

const buttonVariants = cva(
  "inline-flex items-center justify-center rounded-md font-medium transition-colors",
  {
    variants: {
      variant: {
        default: "bg-primary text-primary-foreground hover:bg-primary/90",
        destructive: "bg-destructive text-destructive-foreground hover:bg-destructive/90",
      },
      size: {
        default: "h-10 px-4 py-2",
        sm: "h-9 rounded-md px-3",
        lg: "h-11 rounded-md px-8",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
);
```

## Performance Standards

### 1. Code Splitting
- Use dynamic imports for large components
- Implement lazy loading for routes
- Split by feature boundaries

