## Domain Events

### 1. Event Definition
```typescript
// core/shared/events/domain-events.ts
export abstract class DomainEvent {
  constructor(
    public readonly aggregateId: string,
    public readonly occurredAt: Date = new Date(),
    public readonly eventId: string = generateId()
  ) {}
  
  abstract get eventType(): string;
}

export class InvestigationCreatedEvent extends DomainEvent {
  constructor(
    investigationId: string,
    public readonly name: string,
    public readonly createdBy: string
  ) {
    super(investigationId);
  }
  
  get eventType(): string {
    return "investigation.created";
  }
}

export class EvidenceAnalyzedEvent extends DomainEvent {
  constructor(
    investigationId: string,
    public readonly evidenceFileId: string,
    public readonly confidence: number,
    public readonly analyzedBy: string
  ) {
    super(investigationId);
  }
  
  get eventType(): string {
    return "evidence.analyzed";
  }
}
```

### 2. Event Publisher
```typescript
// core/shared/events/event-publisher.ts
export interface DomainEventPublisher {
  publish(event: DomainEvent): Promise<void>;
  publishBatch(events: DomainEvent[]): Promise<void>;
}

export class EventPublisher implements DomainEventPublisher {
  constructor(
    private readonly eventStore: EventStore,
    private readonly handlers: Map<string, DomainEventHandler[]>
  ) {}
  
  async publish(event: DomainEvent): Promise<void> {
    // 1. Store event
    await this.eventStore.append(event);
    
    // 2. Notify handlers
    const handlers = this.handlers.get(event.eventType) || [];
    await Promise.all(
      handlers.map(handler => handler.handle(event))
    );
  }
  
  registerHandler(eventType: string, handler: DomainEventHandler): void {
    if (!this.handlers.has(eventType)) {
      this.handlers.set(eventType, []);
    }
    this.handlers.get(eventType)!.push(handler);
  }
}
```

## Error Handling

### 1. Domain Errors
```typescript
// core/shared/errors/domain-errors.ts
export abstract class DomainError extends Error {
  constructor(
    message: string,
    public readonly code: string
  ) {
    super(message);
    this.name = this.constructor.name;
  }
}

export class InvestigationNotFoundError extends DomainError {
  constructor(investigationId: string) {
    super(
      `Investigation with ID ${investigationId} not found`,
      "INVESTIGATION_NOT_FOUND"
    );
  }
}

export class UnauthorizedAccessError extends DomainError {
  constructor(userId: string, resource: string) {
    super(
      `User ${userId} does not have access to ${resource}`,
      "UNAUTHORIZED_ACCESS"
    );
  }
}

export class InvalidInvestigationStateError extends DomainError {
  constructor(currentState: string, operation: string) {
    super(
      `Cannot perform ${operation} on investigation in ${currentState} state`,
      "INVALID_INVESTIGATION_STATE"
    );
  }
}
```

## Testing Standards

### 1. Domain Entity Tests
```typescript
// core/investigation/entities/__tests__/investigation.test.ts
describe("Investigation Entity", () => {
  describe("creation", () => {
    it("should create investigation with valid data", () => {
      const data = {
        name: "Test Investigation",
        description: "Test description",
        createdBy: "user-123"
      };
      
      const investigation = Investigation.create(data);
      
      expect(investigation.name).toBe(data.name);
      expect(investigation.status).toBe(InvestigationStatus.DRAFT);
      expect(investigation.createdBy).toBe(data.createdBy);
    });
    
    it("should throw error for invalid name", () => {
      const data = {
        name: "",
        description: "Test description", 
        createdBy: "user-123"
      };
      
      expect(() => Investigation.create(data))
        .toThrow(DomainError);
    });
  });
  
  describe("evidence management", () => {
    it("should add evidence file to draft investigation", () => {
      const investigation = createTestInvestigation();
      const evidenceFile = createTestEvidenceFile();
      
      investigation.addEvidenceFile(evidenceFile);
      
      expect(investigation.evidenceFiles).toHaveLength(1);
      expect(investigation.evidenceFiles[0]).toBe(evidenceFile);
    });
    
    it("should not allow adding evidence to archived investigation", () => {
      const investigation = createTestInvestigation();
      investigation.archive();
      const evidenceFile = createTestEvidenceFile();
      
      expect(() => investigation.addEvidenceFile(evidenceFile))
        .toThrow(DomainError);
    });
  });
});
