# Public variables (safe for browser bundles). Prefix with VITE_.
# Application display name shown in metadata and UI chrome.
VITE_APP_NAME=Investigate

# Public site origin used for absolute URLs in metadata (no trailing slash).
VITE_APP_URL=http://localhost:3000

# Optional public analytics flag (disabled by default; no provider wired).
VITE_ENABLE_ANALYTICS=false

# Server-only variables (never import these into client modules).
# Node environment.
NODE_ENV=development

# Optional server-only session signing secret extension point.
# SERVER_SESSION_SECRET=replace-me-with-a-long-random-value
